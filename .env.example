# BS21 hardware configuration (auto-loaded by tools scripts)
# Copy this file to .env at the project root and fill in your values.
# All serial ports MUST use /dev/serial/by-path/ stable paths
# (e.g. pci-0000:00:14.0-usb-0:1-2.3:1.0-port0). ttyUSB* numbers drift after
# replugging, never use them here.
#
# Find your paths with: ls -l /dev/serial/by-path/

# Board A (G/sle_pair) module serial port and reset pin
BS21_BOARD_A_PORT=/dev/serial/by-path/<board-a-serial-port>
BS21_BOARD_A_RST_PORT=/dev/serial/by-path/<ctrl-serial-port>
BS21_BOARD_A_RST_PIN=8

# Board B (T/sle_accept) module serial port and reset pin
BS21_BOARD_B_PORT=/dev/serial/by-path/<board-b-serial-port>
BS21_BOARD_B_RST_PORT=/dev/serial/by-path/<ctrl-serial-port>
BS21_BOARD_B_RST_PIN=11